{
  "name": "eclipse-cdt",
  "displayName": "Eclipse CDT",
  "description": "%description%",
  "version": "0.5.0",
  "publisher": "ybyllc",
  "license": "MIT",
  "icon": "media/extension-icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "Eclipse",
    "CDT",
    "embedded",
    "headless build",
    "GD32",
    "Flagchip"
  ],
  "activationEvents": [
    "workspaceContains:.cproject",
    "onCommand:eclipseBridge.build",
    "onCommand:eclipseBridge.flash",
    "onCommand:eclipseBridge.cleanBuild",
    "onCommand:eclipseBridge.selectConfiguration",
    "onCommand:eclipseBridge.selectInstallation",
    "onCommand:eclipseBridge.selectWorkspace",
    "onCommand:eclipseBridge.toggleAutoImport",
    "onCommand:eclipseBridge.showProjectInfo",
    "onView:eclipseBridge.sidebar",
    "onTaskType:eclipse-cdt"
  ],
  "main": "./src/extension.js",
  "scripts": {
    "test": "node --test",
    "package": "vsce package"
  },
  "dependencies": {
    "fast-xml-parser": "^5.2.5"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.2"
  },
  "contributes": {
    "commands": [
      {
        "command": "eclipseBridge.build",
        "title": "%command.build%",
        "icon": "$(tools)"
      },
      {
        "command": "eclipseBridge.flash",
        "title": "%command.flash%",
        "icon": "$(zap)"
      },
      {
        "command": "eclipseBridge.cleanBuild",
        "title": "%command.cleanBuild%"
      },
      {
        "command": "eclipseBridge.selectConfiguration",
        "title": "%command.selectConfiguration%"
      },
      {
        "command": "eclipseBridge.selectInstallation",
        "title": "%command.selectInstallation%"
      },
      {
        "command": "eclipseBridge.showProjectInfo",
        "title": "%command.showProjectInfo%"
      },
      {
        "command": "eclipseBridge.selectWorkspace",
        "title": "%command.selectWorkspace%"
      },
      {
        "command": "eclipseBridge.toggleAutoImport",
        "title": "%command.toggleAutoImport%"
      },
      {
        "command": "eclipseBridge.refreshSidebar",
        "title": "%command.refreshSidebar%",
        "icon": "$(refresh)"
      },
      {
        "command": "eclipseBridge.selectIconTheme",
        "title": "%command.selectIconTheme%"
      },
      {
        "command": "eclipseBridge.build.tools",
        "title": "%command.build%",
        "icon": "$(tools)"
      },
      {
        "command": "eclipseBridge.flash.tools",
        "title": "%command.flash%",
        "icon": "$(zap)"
      },
      {
        "command": "eclipseBridge.build.hardware",
        "title": "%command.build%",
        "icon": "$(circuit-board)"
      },
      {
        "command": "eclipseBridge.flash.hardware",
        "title": "%command.flash%",
        "icon": "$(run)"
      },
      {
        "command": "eclipseBridge.build.build",
        "title": "%command.build%",
        "icon": "$(gear)"
      },
      {
        "command": "eclipseBridge.flash.build",
        "title": "%command.flash%",
        "icon": "$(play)"
      },
      {
        "command": "eclipseBridge.build.package",
        "title": "%command.build%",
        "icon": "$(package)"
      },
      {
        "command": "eclipseBridge.flash.package",
        "title": "%command.flash%",
        "icon": "$(cloud-upload)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "eclipseBridge",
          "title": "Eclipse CDT",
          "icon": "media/activitybar-icon.png"
        }
      ]
    },
    "views": {
      "eclipseBridge": [
        {
          "id": "eclipseBridge.sidebar",
          "name": "Project",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "eclipseBridge.refreshSidebar",
          "when": "view == eclipseBridge.sidebar",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "eclipseBridge.build.tools",
          "when": "eclipseBridge.projectOpen && eclipseBridge.iconTheme == tools",
          "group": "navigation@-100"
        },
        {
          "command": "eclipseBridge.flash.tools",
          "when": "eclipseBridge.projectOpen && eclipseBridge.iconTheme == tools",
          "group": "navigation@-99"
        },
        {
          "command": "eclipseBridge.build.hardware",
          "when": "eclipseBridge.projectOpen && eclipseBridge.iconTheme == hardware",
          "group": "navigation@-100"
        },
        {
          "command": "eclipseBridge.flash.hardware",
          "when": "eclipseBridge.projectOpen && eclipseBridge.iconTheme == hardware",
          "group": "navigation@-99"
        },
        {
          "command": "eclipseBridge.build.build",
          "when": "eclipseBridge.projectOpen && eclipseBridge.iconTheme == build",
          "group": "navigation@-100"
        },
        {
          "command": "eclipseBridge.flash.build",
          "when": "eclipseBridge.projectOpen && eclipseBridge.iconTheme == build",
          "group": "navigation@-99"
        },
        {
          "command": "eclipseBridge.build.package",
          "when": "eclipseBridge.projectOpen && eclipseBridge.iconTheme == package",
          "group": "navigation@-100"
        },
        {
          "command": "eclipseBridge.flash.package",
          "when": "eclipseBridge.projectOpen && eclipseBridge.iconTheme == package",
          "group": "navigation@-99"
        }
      ]
    },
    "keybindings": [
      {
        "command": "eclipseBridge.build",
        "key": "ctrl+b",
        "when": "eclipseBridge.projectOpen && editorTextFocus"
      },
      {
        "command": "eclipseBridge.flash",
        "key": "f11",
        "when": "eclipseBridge.projectOpen && editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Eclipse CDT",
      "properties": {
        "eclipseBridge.installationPath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "%config.installationPath%"
        },
        "eclipseBridge.workspacePath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "%config.workspacePath%"
        },
        "eclipseBridge.configuration": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "%config.configuration%"
        },
        "eclipseBridge.launchConfiguration": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "%config.launchConfiguration%"
        },
        "eclipseBridge.elfPath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "%config.elfPath%"
        },
        "eclipseBridge.autoImport": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "%config.autoImport%"
        },
        "eclipseBridge.toolbarIcons": {
          "type": "string",
          "enum": [
            "tools",
            "hardware",
            "build",
            "package"
          ],
          "default": "tools",
          "scope": "window",
          "description": "%config.toolbarIcons%"
        }
      }
    },
    "taskDefinitions": [
      {
        "type": "eclipse-cdt",
        "required": [
          "mode"
        ],
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "build",
              "cleanBuild"
            ],
            "description": "%task.mode%"
          },
          "projectDirectory": {
            "type": "string",
            "description": "%task.projectDirectory%"
          },
          "configuration": {
            "type": "string",
            "description": "%task.configuration%"
          }
        }
      }
    ]
  }
}
